{
  "name": "@tomasmendoza-unq/http-client",
  "version": "1.0.0",
  "description": "Reusable Axios HTTP client with typed HttpError, interceptors, JWT helpers, and session refresh pipeline",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomasmendoza-unq/http-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "axios": "^1.7.9",
    "jwt-decode": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2"
  }
}
